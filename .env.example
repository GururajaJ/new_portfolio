# Contact form email delivery (server-side only — never exposed to the browser).
# Copy this file to `.env.local` and fill in real values, or set these in your
# hosting provider (e.g. Vercel > Project > Settings > Environment Variables).
#
# Without these set, the contact form will show a friendly "email isn't
# configured" message and fall back to the mailto link.

# SMTP server hostname (e.g. smtp.gmail.com)
SMTP_HOST=
# SMTP port (587 for STARTTLS, 465 for implicit TLS). Defaults to 587.
SMTP_PORT=587
# Set to "true" to force implicit TLS. Auto-enabled for port 465.
SMTP_SECURE=
# SMTP username (often your email address)
SMTP_USER=
# SMTP password or app-specific password (for Gmail, create an "App Password")
SMTP_PASS=

# Where contact-form messages are delivered. Defaults to the `email` in
# src/config/portfolio.ts if unset.
CONTACT_TO=
# The From address for outgoing mail. Defaults to SMTP_USER if unset.
CONTACT_FROM=
